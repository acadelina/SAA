# Copy this file to .env before running docker compose.
# The values are local development defaults, not secrets.

REDIS_PORT=6379
POSTGRES_PORT=5432
POSTGRES_USER=shifting_hulls
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=shifting_hulls

# Used by the ingestion consumer on the host.
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql://shifting_hulls:change-me-local-only@127.0.0.1:5432/shifting_hulls
