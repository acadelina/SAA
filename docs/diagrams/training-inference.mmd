flowchart LR
    subgraph OFF["Offline · training (outside the daily loop)"]
        direction TB
        REPLAY["Replay stored days<br/>from PostgreSQL"]
        SPLIT["Split by time and seed"]
        TRAIN["Train risk scorer<br/>tune LLM prompts"]
        STORE[("Model store<br/>versioned files + metadata")]
        REPLAY --> SPLIT --> TRAIN --> STORE
    end

    subgraph ON["Online · every simulated day"]
        direction TB
        LOAD["Load current scorer<br/>and the local LLM"]
        RUN["Answer tool calls<br/>and build the plan"]
        LOG["Log inputs, outputs<br/>and latency"]
        LOAD --> RUN --> LOG
    end

    STORE --> LOAD
    LOG -.->|"inspection results<br/>(drift re-scoring)"| REPLAY
