flowchart TB
    SIM["<b>Simulator</b> · outside the system<br/>fleet, registries, inspection outcomes"]

    subgraph SYS["Shifting Hulls system · Docker Compose, one machine"]
        direction TB

        subgraph IN["1 · Ingestion (continuous)"]
            direction LR
            RS[("<b>Redis Streams</b><br/>ais · compliance · results")]
            ING["<b>Ingestion consumer</b><br/>Pydantic schema check"]
            FEAT["<b>Feature service</b><br/>per-hull identity timelines"]
            RS --> ING
        end

        subgraph DB["2 · Storage (PostgreSQL)"]
            direction LR
            QUA[("quarantine")]
            RAW[("raw + clean rows")]
            HF[("hull features")]
            LOG[("plans, tool-call logs,<br/>metrics, model registry")]
        end

        subgraph AI["3 · AI decision (once per simulated day)"]
            direction LR
            PRE["<b>Prefect</b><br/>daily flow"]
            AGT["<b>Decision agent</b><br/>LLM, agent prompt"]
            MCP["<b>MCP tool server</b><br/>read-only tools +<br/>submit_inspection_plan"]
            SCO["<b>Risk scorer</b><br/>LightGBM"]
            RES["<b>Resolver</b><br/>LLM, resolver prompt"]
            VLLM["<b>vLLM</b><br/>one local 4-bit model"]
            MS[("<b>Model store</b><br/>versioned scorer")]
            VAL["<b>Plan validator</b><br/>budget K, schema, timeout"]

            PRE -->|"start day d, K"| AGT
            AGT <-->|"tool calls"| MCP
            MCP --> SCO
            MCP --> RES
            MS --> SCO
            AGT -.-> VLLM
            RES -.-> VLLM
            MCP -->|"proposed plan"| VAL
            SCO -->|"top-K fallback"| VAL
        end

        API["<b>FastAPI</b> · REST API + dashboard"]
    end

    USER(["Inspector / analyst"])

    SIM -->|"AIS, compliance events,<br/>inspection results"| RS
    ING -->|"invalid"| QUA
    ING -->|"valid"| RAW
    RAW --> FEAT
    FEAT --> HF
    HF -->|"features, timelines"| MCP
    VAL -->|"final plan"| LOG
    VAL ==>|"inspection plan (via Prefect)"| SIM
    LOG --> API
    API --> USER
